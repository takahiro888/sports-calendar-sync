{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/ical/dodgers.ics",
        "function": "icalFeed",
        "region": "asia-northeast1"
      },
      {
        "source": "/ical/sasaki.ics",
        "function": "icalSasakiFeed",
        "region": "asia-northeast1"
      },
      {
        "source": "/ical/yamamoto.ics",
        "function": "icalYamamotoFeed",
        "region": "asia-northeast1"
      },
      {
        "source": "/ical/ohtani.ics",
        "function": "icalOhtaniFeed",
        "region": "asia-northeast1"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions"
  }
}
